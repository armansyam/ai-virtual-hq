# ==============================================================================
# AI Virtual HQ — Standalone 3D Multi-Agent Server (.env.example)
# Salin file ini menjadi `.env` lalu sesuaikan untuk server / VPS Anda.
# JANGAN PERNAH commit file `.env` asli ke Git!
# ==============================================================================

# Server Network
APP_HOST=0.0.0.0
APP_PORT=8484

# Set `true` saat berjalan di belakang HTTPS (Nginx / Caddy / Cloudflare)
APP_COOKIE_SECURE=false

# Akun Admin / CEO
# Kosongkan ADMIN_PASSWORD & ADMIN_PASSWORD_HASH jika ingin membuat akun Admin
# secara interaktif lewat tombol "Setup Admin" di browser pada kunjungan pertama.
ADMIN_USERNAME=ceo
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Kunci Rahasia Tanda Tangan Cookie Sesi (isi minimal 32 karakter hex acak)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_HOURS=72

# Public Live View (Halaman Utama `/` Read-Only untuk Publik)
PUBLIC_LIVE_VIEW_ENABLED=true
# Opsional: isi token jika Live View publik hanya boleh dibuka lewat /?token=...
PUBLIC_LIVE_VIEW_TOKEN=
# Opsional: domain yang diizinkan meng-embed 3D Live View via <iframe> (pisahkan spasi)
# Contoh: ALLOW_IFRAME_ORIGINS=https://website-anda.com https://app.website-anda.com
ALLOW_IFRAME_ORIGINS=
